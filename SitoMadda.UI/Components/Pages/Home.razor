@page "/"
@inject SiteContent contenutiSito

<PageTitle>Home · Maddalena Pimponi, psicologa</PageTitle>

<section class="hero section-shell">
    <div class="hero-copy">
        <p class="eyebrow"><span class="spiral-mark" aria-hidden="true"></span>Psicologa clinica dello sviluppo</p>
        <h1><span class="hero-prefix">Dott.ssa</span>Maddalena<br /><em>Pimponi</em></h1>
        <p class="hero-subtitle">Psicologa a Orvieto, Narni e online</p>
        <p class="hero-description">Consulenza e sostegno psicologico, con un focus sulla fascia pre-adolescenziale, adolescenziale e dei giovani adulti.</p>
        <div class="button-row">
            <a class="button button-primary" href="/contatti">Prenota un primo colloquio <span aria-hidden="true">→</span></a>
            <a class="button button-outline" href="@contenutiSito.CollegamentoWhatsApp" target="_blank" rel="noopener noreferrer">Scrivimi su WhatsApp</a>
        </div>
        <p class="hero-note">Ricevo su appuntamento, anche in videochiamata.</p>
    </div>

    <div class="hero-art">
        <figure class="hero-figure">
            <span class="portrait-circle portrait-circle--hero">
                <img src="images/maddalena-ritratto.jpg" alt="Ritratto della Dott.ssa Maddalena Pimponi" width="720" height="720" fetchpriority="high" decoding="async" />
            </span>
            <figcaption class="hero-caption">
                <span class="hero-caption-quote">Chiedere aiuto è una forma di cura verso <span class="nowrap">se stessi/e</span></span>
                <span class="hero-caption-name">Maddalena Pimponi</span>
            </figcaption>
        </figure>
    </div>
</section>

<section class="trust-strip">
    <div class="section-shell trust-inner">
        <p class="trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3 5 6v6c0 4.2 2.9 7.9 7 9 4.1-1.1 7-4.8 7-9V6l-7-3Z" />
                <path d="m9 12 2 2 4-4" />
            </svg>
            Albo degli Psicologi dell’Umbria n. 1913
        </p>
        <p class="trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H20v14H6.5A2.5 2.5 0 0 0 4 20.5v-14Z" />
                <path d="M8 8h8M8 11.5h6" />
            </svg>
            Tutor&nbsp;DSA&nbsp;·&nbsp;BES&nbsp;·&nbsp;ADHD
        </p>
        <p class="trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" />
                <circle cx="12" cy="10" r="2.6" />
            </svg>
            Orvieto · Narni · Online
        </p>
    </div>
</section>

<section class="section section-white">
    <div class="section-shell intro-grid">
        <div>
            <span class="label-tag">Mi presento</span>
            <h2>Una presa in carico<br />della persona<br /><em>a 360 gradi</em></h2>
        </div>
        <div class="intro-text">
            <p>Sono una psicologa laureata a Padova in Psicologia Clinica dello Sviluppo, con un focus sulla fascia pre-adolescenziale, adolescenziale e dei giovani adulti.</p>
            <p>Credo in una presa in carico della persona a 360 gradi, che tenga conto della complessità umana e delle sue relazioni, nel rispetto dei tempi e dei modi di ognuna e di ognuno.</p>
            <a class="text-link" href="/chi-sono">Scopri la mia storia <span aria-hidden="true">→</span></a>
        </div>
    </div>
</section>

<section class="section section-blush">
    <div class="section-shell centered">
        <p class="eyebrow eyebrow--center"><span class="spiral-mark" aria-hidden="true"></span>Di cosa mi occupo</p>
        <h2 class="section-heading">Consulenza e sostegno<br />psicologico per:</h2>
        <div class="paper-grid">
            <a class="paper-card" href="/di-cosa-mi-occupo#risorse">
                <span class="paper-index">01</span>
                <span class="paper-title">Sviluppare e potenziare le risorse individuali</span>
                <span class="card-arrow" aria-hidden="true">→</span>
            </a>
            <a class="paper-card" href="/di-cosa-mi-occupo#qualita">
                <span class="paper-index">02</span>
                <span class="paper-title">Migliorare la qualità di vita personale, familiare e sociale</span>
                <span class="card-arrow" aria-hidden="true">→</span>
            </a>
            <a class="paper-card" href="/di-cosa-mi-occupo#ansia">
                <span class="paper-index">03</span>
                <span class="paper-title">Gestire ansia e stress</span>
                <span class="card-arrow" aria-hidden="true">→</span>
            </a>
            <a class="paper-card" href="/di-cosa-mi-occupo#alimentazione">
                <span class="paper-index">04</span>
                <span class="paper-title">Gestire difficoltà legate alla sfera dell’alimentazione</span>
                <span class="card-arrow" aria-hidden="true">→</span>
            </a>
            <a class="paper-card" href="/di-cosa-mi-occupo#disagio">
                <span class="paper-index">05</span>
                <span class="paper-title">Gestire il disagio emotivo, comportamentale e relazionale</span>
                <span class="card-arrow" aria-hidden="true">→</span>
            </a>
            <a class="paper-card" href="/di-cosa-mi-occupo#crisi">
                <span class="paper-index">06</span>
                <span class="paper-title">Affrontare crisi e disagi momentanei</span>
                <span class="card-arrow" aria-hidden="true">→</span>
            </a>
        </div>
        <p class="handwritten">Chiedere aiuto è una forma di cura verso se stessi/e</p>
    </div>
</section>

<section class="section section-white">
    <div class="section-shell">
        <div class="section-heading-row">
            <div>
                <p class="eyebrow"><span class="spiral-mark" aria-hidden="true"></span>Dove ricevo</p>
                <h2>Orvieto, Narni e online</h2>
                <p class="muted">Ricevo su appuntamento in due studi della provincia di Terni e svolgo colloqui online.</p>
            </div>
            <a class="text-link" href="/contatti">Informazioni e appuntamenti <span aria-hidden="true">→</span></a>
        </div>
        <div class="location-grid">
            @foreach (var studio in contenutiSito.Studi)
            {
                <article class="location-card">
                    <span class="location-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" />
                            <circle cx="12" cy="10" r="2.6" />
                        </svg>
                    </span>
                    <div>
                        <h3>@studio.Nome</h3>
                        <p><strong>@studio.Struttura</strong><br />@studio.Indirizzo<br />@studio.Citta</p>
                        <a class="text-link" href="@studio.UrlRicercaMappa" target="_blank" rel="noopener noreferrer">Mostra la mappa <span aria-hidden="true">→</span></a>
                    </div>
                </article>
            }
            <article class="location-card location-online">
                <span class="location-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="6" width="13" height="10" rx="2.5" />
                        <path d="M16 10.5 21 8v8l-5-2.5V10.5Z" />
                    </svg>
                </span>
                <div>
                    <h3>Online</h3>
                    <p>Colloqui in videochiamata, ovunque tu sia.</p>
                    <a class="text-link" href="/contatti">Chiedi un colloquio online <span aria-hidden="true">→</span></a>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="section section-white section--flush-top">
    <div class="section-shell">
        <div class="closing-cta">
            <div>
                <p class="eyebrow"><span class="spiral-mark" aria-hidden="true"></span>Per informazioni</p>
                <h2>Fissiamo un<br /><em>primo colloquio</em></h2>
                <p>Non serve avere le idee chiare: bastano poche righe. Ti risponderò per trovare insieme il momento giusto.</p>
            </div>
            <a class="button button-primary" href="/contatti">Scrivimi <span aria-hidden="true">→</span></a>
        </div>
    </div>
</section>
