@page "/contatti"
@rendermode InteractiveServer
@inject SiteContent contenutiSito
@inject IEmailSender servizioEmail
@inject ILogger<Contatti> logger

<PageTitle>Contatti e appuntamenti · Maddalena Pimponi</PageTitle>

<PageHero Titolo="Per informazioni e appuntamenti" Descrizione="Puoi chiamarmi, scrivermi su WhatsApp o per email, oppure lasciarmi un messaggio dal modulo. Ricevo su appuntamento a Orvieto, a Narni e online." />

<section class="section section-white">
    <div class="section-shell contact-layout">
        <div class="contact-form-card">
            <h2>Richiedi un primo colloquio</h2>
            <p class="muted">Non serve avere le idee chiare: bastano poche righe.</p>

            <EditForm Model="@richiesta" OnValidSubmit="InviaRichiestaAsync">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div class="form-field">
                        <label for="contact-name">Nome e cognome</label>
                        <InputText id="contact-name" @bind-Value="richiesta.Nome" autocomplete="name" />
                        <ValidationMessage For="@(() => richiesta.Nome)" />
                    </div>
                    <div class="form-field">
                        <label for="contact-email">Email</label>
                        <InputText id="contact-email" type="email" @bind-Value="richiesta.Email" autocomplete="email" />
                        <ValidationMessage For="@(() => richiesta.Email)" />
                    </div>
                    <div class="form-field full-field">
                        <label for="contact-phone">Telefono <span>(facoltativo)</span></label>
                        <InputText id="contact-phone" type="tel" @bind-Value="richiesta.Telefono" autocomplete="tel" />
                        <ValidationMessage For="@(() => richiesta.Telefono)" />
                    </div>
                    <div class="form-field full-field">
                        <label for="contact-subject">Di cosa vorresti parlarmi? <span>(facoltativo)</span></label>
                        <InputSelect id="contact-subject" @bind-Value="richiesta.Argomento">
                            <option value="">Seleziona un argomento</option>
                            <option>Primo colloquio</option>
                            <option>Ansia e stress</option>
                            <option>Alimentazione e rapporto con il corpo</option>
                            <option>Supporto allo studio</option>
                            <option>Altro</option>
                        </InputSelect>
                    </div>
                    <div class="form-field full-field">
                        <label for="contact-message">Messaggio</label>
                        <InputTextArea id="contact-message" @bind-Value="richiesta.Messaggio" rows="5" />
                        <ValidationMessage For="@(() => richiesta.Messaggio)" />
                        <small>Per tutelare la tua privacy, evita di inserire informazioni sanitarie o dettagli particolarmente sensibili.</small>
                    </div>
                    <div class="form-field full-field consent-field">
                        <label><InputCheckbox @bind-Value="richiesta.PrivacyAccettata" /> <span>Confermo di aver letto l’<a href="/privacy" target="_blank" rel="noopener noreferrer">informativa privacy</a> e acconsento a essere ricontattato/a.</span></label>
                    </div>
                    <div class="form-field full-field">
                        <button class="button button-primary" type="submit" disabled="@invioInCorso">
                            @(invioInCorso ? "Invio in corso…" : "Invia il messaggio") <span aria-hidden="true">→</span>
                        </button>
                        @if (!string.IsNullOrWhiteSpace(messaggioStato))
                        {
                            <p class="form-status @(invioRiuscito ? "success" : "error")" role="@(invioRiuscito ? "status" : "alert")">@messaggioStato</p>
                        }
                    </div>
                </div>
            </EditForm>
            <p class="form-note">Il modulo invia i dati alla psicologa tramite email. Non utilizzare per richieste urgenti o emergenze.</p>
        </div>

        <aside class="contact-aside">
            <a class="contact-method" href="@contenutiSito.CollegamentoTelefono">
                <span class="method-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                        <path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z" />
                    </svg>
                </span>
                <span><small>Telefono</small>@contenutiSito.TelefonoVisualizzato</span>
            </a>
            <a class="contact-method" href="@contenutiSito.CollegamentoWhatsApp" target="_blank" rel="noopener noreferrer">
                <span class="method-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3.5 20.5l1.4-4.3A8.5 8.5 0 1 1 20.5 11.6Z" />
                        <path d="M8.7 8.4c.3-.5.7-.5 1-.5h.6c.2 0 .4.1.5.4l.7 1.6c.1.3 0 .5-.2.7l-.5.6a6 6 0 0 0 3.1 3.1l.6-.5c.2-.2.4-.3.7-.2l1.6.7c.3.1.4.3.4.5v.6c0 .4-.1.8-.6 1a2 2 0 0 1-1.5.4 9 9 0 0 1-7.3-7.3 2 2 0 0 1 .4-1.6Z" />
                    </svg>
                </span>
                <span><small>WhatsApp</small>Scrivimi un messaggio</span>
            </a>
            <a class="contact-method" href="@contenutiSito.CollegamentoMioDottore" target="_blank" rel="noopener noreferrer">
                <span class="method-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3 5 6v6c0 4.2 2.9 7.9 7 9 4.1-1.1 7-4.8 7-9V6l-7-3Z" />
                        <path d="m9 12 2 2 4-4" />
                    </svg>
                </span>
                <span><small>Profilo professionale</small>MioDottore</span>
            </a>
            <a class="contact-method" href="mailto:@contenutiSito.IndirizzoEmail">
                <span class="method-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="5.5" width="18" height="13" rx="2.5" />
                        <path d="m4 7 8 6 8-6" />
                    </svg>
                </span>
                <span><small>Email</small>@contenutiSito.IndirizzoEmail</span>
            </a>
            <div class="contact-method">
                <span class="method-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" />
                        <circle cx="12" cy="10" r="2.6" />
                    </svg>
                </span>
                <span><small>Ricevo su appuntamento</small>Orvieto · Narni · Online</span>
            </div>
        </aside>
    </div>
</section>

<section class="section section-blush">
    <div class="section-shell">
        <div class="section-heading-row">
            <div><p class="eyebrow"><span class="spiral-mark" aria-hidden="true"></span> Dove ricevo</p><h2>Gli studi</h2></div>
        </div>
        <div class="map-grid">
            @foreach (var studio in contenutiSito.Studi)
            {
                <article class="map-card">
                    <div class="map-details">
                        <p class="eyebrow"><span class="spiral-mark" aria-hidden="true"></span> @studio.Nome</p>
                        <h3>@studio.Struttura</h3>
                        <p>@studio.Indirizzo<br />@studio.Citta</p>
                        <a class="button button-outline" href="@studio.UrlRicercaMappa" target="_blank" rel="noopener noreferrer">Apri in Google Maps <span>↗</span></a>
                    </div>
                    <iframe title="Mappa dello studio di @studio.Nome"
                            src="@studio.UrlMappaIncorporata"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            allowfullscreen></iframe>
                </article>
            }
        </div>
    </div>
</section>

@code {
    private ContactRequest richiesta = new();
    private bool invioInCorso;
    private bool invioRiuscito;
    private string? messaggioStato;

    /// <summary>
    /// Gestisce l'invio del modulo: controlla il consenso, chiama il servizio email e
    /// comunica l'esito in pagina.
    /// </summary>
    /// <remarks>
    /// Il consenso privacy non è una validazione del modello ma una condizione esplicita:
    /// senza spunta il messaggio non parte. Gli errori di configurazione e di invio vengono
    /// registrati nei log e tradotti in un testo generico per il visitatore, che altrimenti
    /// vedrebbe dettagli tecnici. Al termine il pulsante torna attivo e, in caso di successo,
    /// il modulo viene svuotato.
    /// </remarks>
    private async Task InviaRichiestaAsync()
    {
        messaggioStato = null;
        invioRiuscito = false;

        // La casella non ha attributi di validazione: il controllo va fatto qui, lato server.
        if (!richiesta.PrivacyAccettata)
        {
            messaggioStato = "Per inviare il messaggio, conferma di aver letto l’informativa privacy.";
            return;
        }

        // Il flag disabilita il pulsante mentre la richiesta è in corso ed evita invii doppi.
        invioInCorso = true;
        try
        {
            await servizioEmail.InviaRichiestaContattoAsync(richiesta);
            richiesta = new ContactRequest();
            invioRiuscito = true;
            messaggioStato = "Messaggio inviato correttamente. Grazie per avermi scritto.";
        }
        // Configurazione SMTP assente: è un caso di sviluppo, non va mostrato nei dettagli.
        catch (InvalidOperationException errore)
        {
            logger.LogWarning(errore, "Modulo contatti non configurato: invio email non disponibile.");
            messaggioStato = "Il modulo non è al momento attivo. Puoi scrivermi direttamente a " + contenutiSito.IndirizzoEmail + ".";
        }
        // Qualsiasi altro errore (SMTP, formato degli indirizzi, annullamento): log completo,
        // al visitatore solo l'alternativa concreta, cioè scrivere all'indirizzo diretto.
        catch (Exception errore)
        {
            logger.LogError(errore, "Invio email di contatto non riuscito.");
            messaggioStato = "Non è stato possibile inviare il messaggio. Riprova più tardi oppure scrivi direttamente a " + contenutiSito.IndirizzoEmail + ".";
        }
        finally
        {
            invioInCorso = false;
        }
    }
}
