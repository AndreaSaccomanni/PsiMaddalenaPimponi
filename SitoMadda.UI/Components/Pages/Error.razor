@page "/Error"
@using System.Diagnostics

<PageTitle>Errore · Maddalena Pimponi</PageTitle>

<PageHero Illustrazione="IllustrazioneTestata.IllustrazioneTestataTipo.Nodo" Titolo="Si è verificato un errore" Descrizione="La richiesta non è stata completata. Riprova tra poco." />

<section class="section section-white">
    <div class="section-shell">
        @if (MostraIdentificativoRichiesta)
        {
            <p><strong>Identificativo richiesta:</strong> <code>@IdentificativoRichiesta</code></p>
        }

        <p>Se il problema persiste, riprova più tardi o torna alla <a class="text-link" href="/">pagina iniziale</a>.</p>
    </div>
</section>

@code{
    [CascadingParameter]
    private HttpContext? ContestoHttp { get; set; }

    private string? IdentificativoRichiesta { get; set; }
    private bool MostraIdentificativoRichiesta => !string.IsNullOrEmpty(IdentificativoRichiesta);

    /// <summary>Recupera l'identificativo utile a correlare l'errore con i log dell'applicazione.</summary>
    protected override void OnInitialized() =>
        IdentificativoRichiesta = Activity.Current?.Id ?? ContestoHttp?.TraceIdentifier;
}
