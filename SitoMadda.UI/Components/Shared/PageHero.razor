@using Microsoft.AspNetCore.Components

<section class="page-hero">
    <div class="section-shell page-hero-inner">
        <div class="page-hero-copy">
            <h1>@Titolo</h1>
            <p>@Descrizione</p>
        </div>

        @if (Illustrazione is not null)
        {
            <div class="page-hero-art" aria-hidden="true">
                <IllustrazioneTestata Tipo="Illustrazione.Value" />
            </div>
        }
    </div>
</section>

@code {
    /// <summary>Imposta il titolo principale della testata della pagina.</summary>
    [Parameter, EditorRequired]
    public string Titolo { get; set; } = string.Empty;

    /// <summary>Imposta il testo introduttivo visualizzato sotto il titolo.</summary>
    [Parameter, EditorRequired]
    public string Descrizione { get; set; } = string.Empty;

    /// <summary>
    /// Disegno decorativo opzionale a destra del titolo. Se non viene indicato la testata
    /// resta solo testo, occupando l'intera larghezza disponibile.
    /// </summary>
    [Parameter]
    public IllustrazioneTestata.IllustrazioneTestataTipo? Illustrazione { get; set; }
}
