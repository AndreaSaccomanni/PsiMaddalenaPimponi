@inject NavigationManager Navigazione

@* Titolo, description e anteprime social derivano dal catalogo SitePages, così ogni pagina
   pubblica ha gli stessi metadati coerenti con la sitemap. Le pagine di errore non emettono
   canonical e dichiarano noindex. *@

<PageTitle>@Pagina.Titolo</PageTitle>

<HeadContent>
    <meta name="description" content="@Pagina.Descrizione" />

    @if (!Pagina.Indicizzabile)
    {
        <meta name="robots" content="noindex, follow" />
    }
    else
    {
        <link rel="canonical" href="@UrlCanonica" />
        <meta property="og:url" content="@UrlCanonica" />
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Dott.ssa Maddalena Pimponi" />
    <meta property="og:title" content="@Pagina.Titolo" />
    <meta property="og:description" content="@Pagina.Descrizione" />
    <meta property="og:image" content="@UrlImmagine" />
    <meta property="og:image:width" content="720" />
    <meta property="og:image:height" content="720" />
    <meta name="twitter:card" content="summary_large_image" />
</HeadContent>

@code {
    /// <summary>Pagina di cui emettere titolo, description e metadati social.</summary>
    [Parameter, EditorRequired]
    public SitePage Pagina { get; set; } = default!;

    /// <summary>
    /// Indirizzo assoluto della pagina, ricavato dalla richiesta corrente: finché il dominio
    /// non è configurato resta quello dell'ambiente in uso, senza valori da aggiornare.
    /// </summary>
    private string UrlCanonica => Navigazione.BaseUri.TrimEnd('/') + Pagina.Percorso;

    /// <summary>Immagine usata nelle anteprime di social e applicazioni di messaggistica.</summary>
    private string UrlImmagine => Navigazione.BaseUri.TrimEnd('/') + "/images/maddalena-ritratto.jpg";
}
