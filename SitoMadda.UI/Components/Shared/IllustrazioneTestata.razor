@*
    Illustrazione decorativa opzionale della testata: un rametto al tratto, un cerchio tenue
    e pochi punti. Senza cornice, si appoggia al fondo blush della testata. È usata solo
    nelle pagine che la richiedono (Privacy e pagine di errore).
*@
<svg viewBox="0 0 420 420" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
        <linearGradient id="foglia" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#c48fa9" />
            <stop offset="1" stop-color="#a26685" />
        </linearGradient>
        <linearGradient id="fogliaChiara" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#d8adc1" />
            <stop offset="1" stop-color="#bd879f" />
        </linearGradient>
        <linearGradient id="velo" x1="0" y1="0" x2="0.4" y2="1">
            <stop offset="0" stop-color="#f4e4ee" />
            <stop offset="1" stop-color="#e8cbdc" />
        </linearGradient>

        @* Foglia a punta, base nell'origine e punta verso destra. *@
        <path id="fogliaBase" d="M0 0C12-12 30-14 44-4 31 9 13 11 0 0Z" />

        @* Rametto filiforme: gambo lungo e foglie alternate sempre più piccole. *@
        <g id="rametto">
            <path d="M0 0C8-58 26-116 62-184" stroke="var(--plum)" stroke-opacity=".45" stroke-width="1.5" stroke-linecap="round" />
            <use href="#fogliaBase" transform="translate(6 -34) rotate(-38) scale(.44)" fill="url(#foglia)" fill-opacity=".75" />
            <use href="#fogliaBase" transform="translate(12 -62) rotate(-142) scale(.42)" fill="url(#fogliaChiara)" fill-opacity=".8" />
            <use href="#fogliaBase" transform="translate(20 -90) rotate(-36) scale(.38)" fill="url(#fogliaChiara)" fill-opacity=".75" />
            <use href="#fogliaBase" transform="translate(29 -118) rotate(-144) scale(.33)" fill="url(#foglia)" fill-opacity=".8" />
            <use href="#fogliaBase" transform="translate(38 -144) rotate(-38) scale(.28)" fill="url(#fogliaChiara)" fill-opacity=".7" />
            <use href="#fogliaBase" transform="translate(47 -166) rotate(-146) scale(.22)" fill="url(#foglia)" fill-opacity=".65" />
        </g>
    </defs>

    @switch (Tipo)
    {
        case IllustrazioneTestataTipo.Privacy:
            <circle cx="210" cy="172" r="98" stroke="var(--rose)" stroke-opacity=".24" />
            <circle cx="210" cy="172" r="70" fill="url(#velo)" fill-opacity=".45" />
            <use href="#rametto" transform="translate(204 362) rotate(-6)" />
            <circle cx="310" cy="292" r="3.5" fill="var(--rose)" fill-opacity=".45" />
        break;

        default:
            <circle cx="236" cy="164" r="92" stroke="var(--rose)" stroke-opacity=".22" stroke-dasharray="4 11" />
            <use href="#rametto" transform="translate(150 358) rotate(-22)" />
            <circle cx="316" cy="286" r="4" fill="var(--rose)" fill-opacity=".5" />
            <circle cx="120" cy="150" r="3" fill="var(--rose)" fill-opacity=".4" />
        break;
    }
</svg>

@code {
    /// <summary>Composizione mostrata nella testata, quando la pagina ne richiede una.</summary>
    [Parameter]
    public IllustrazioneTestataTipo Tipo { get; set; } = IllustrazioneTestataTipo.Nodo;

    /// <summary>Composizioni disponibili per le testate delle pagine.</summary>
    public enum IllustrazioneTestataTipo
    {
        /// <summary>Rametto centrale con doppio cerchio: pagina Privacy.</summary>
        Privacy,

        /// <summary>Rametto con cerchio tratteggiato: pagine di errore e 404.</summary>
        Nodo
    }
}
