<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="favicon.png" sizes="512x512" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <link rel="stylesheet" href="site.css" />
    <HeadOutlet />
    <script type="application/ld+json">@((MarkupString)DatiStrutturati)</script>
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/navigation.js"></script>
</body>

</html>

@code {
    [Inject]
    private NavigationManager Navigazione { get; set; } = default!;

    [Inject]
    private SiteContent Contenuti { get; set; } = default!;

    /// <summary>
    /// Dati schema.org del sito, calcolati sull'indirizzo da cui arriva la richiesta: quando
    /// il dominio sarà attivo i riferimenti si aggiornano da soli, senza modifiche al codice.
    /// </summary>
    private string DatiStrutturati => StructuredData.PerSito(Navigazione.BaseUri, Contenuti);
}
